# API Keys
OPENAI_API_KEY=sk-your-openai-api-key
XAI_API_KEY=xai-your-xai-api-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/epfiles
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# Environment
APP_ENV=development
# CORS_ORIGINS=["https://your-domain.com"]

# RAG (optional, defaults provided)
# CHROMA_DB_PATH=./chroma_db
# CHROMADB_DOWNLOAD_URL=https://pub-bb289fb1eb1845dda7000f73a13d37cd.r2.dev/chroma_db.zip
# COLLECTION_NAME=epstein_files
# EMBEDDING_MODEL=text-embedding-3-large

# LLM (optional, defaults provided)
# LLM_MODEL=grok-4-1-fast-reasoning
# LLM_MAX_TOKENS=1000
# LLM_TEMPERATURE=0.1
# XAI_BASE_URL=https://api.x.ai/v1

# Retrieval (optional, defaults provided)
# TOP_K_CHUNKS=6
# MIN_SIMILARITY_THRESHOLD=0.3
# MAX_CONTEXT_TOKENS=8000
# MAX_HISTORY_MESSAGES=10

# Rate Limiting
FREE_MESSAGE_LIMIT=10
# RATE_LIMIT_WINDOW_SECONDS=86400
