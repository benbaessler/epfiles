# OpenAI API key for embeddings (text-embedding-3-large)
OPENAI_API_KEY=sk-xxx

# xAI API key for LLM responses (default provider)
XAI_API_KEY=xai-xxx

# PostgreSQL connection URL
# Local: postgresql://user:password@localhost:5432/epfiles
DATABASE_URL=postgresql://user:password@localhost:5432/epfiles

# Path to ChromaDB vector store (relative to backend package)
CHROMA_DB_PATH=./chroma_db

# ChromaDB collection name
COLLECTION_NAME=epstein_files

# Embedding model for vector search
EMBEDDING_MODEL=text-embedding-3-large

# Number of chunks to retrieve for context
TOP_K_CHUNKS=6

# Minimum similarity score (0.0-1.0) to include a chunk
MIN_SIMILARITY_THRESHOLD=0.3

# Maximum context tokens to send to LLM
MAX_CONTEXT_TOKENS=8000

# Maximum conversation history messages
MAX_HISTORY_MESSAGES=10

# Environment mode: "development" or "production"
APP_ENV=development

BACKEND_URL=http://localhost:8000
