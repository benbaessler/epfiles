# =============================================================================
# EPFiles - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# This central config is used by all packages (interface, backend, dataset)

# =============================================================================
# BACKEND - API Keys (Required)
# =============================================================================

# OpenAI API key for embeddings (text-embedding-3-large)
OPENAI_API_KEY=sk-xxx

# xAI/Grok API key for LLM responses (default provider)
XAI_API_KEY=xai-xxx

# Groq API key (optional, only if using Groq as LLM provider)
GROQ_API_KEY=

# =============================================================================
# BACKEND - Database Configuration (Required)
# =============================================================================

# PostgreSQL connection URL
# Local: postgresql://user:password@localhost:5432/epfiles
# Railway: auto-injected as DATABASE_URL
DATABASE_URL=postgresql://user:password@localhost:5432/epfiles

# =============================================================================
# BACKEND - RAG Configuration
# =============================================================================

# Path to ChromaDB vector store (relative to backend package)
CHROMA_DB_PATH=./chroma_db

# ChromaDB collection name
COLLECTION_NAME=epstein_files

# Embedding model for vector search
EMBEDDING_MODEL=text-embedding-3-large

# =============================================================================
# BACKEND - LLM Configuration
# =============================================================================

# LLM provider: "openai", "groq", or "xai"
LLM_PROVIDER=xai

# Model name (depends on provider)
# xAI: grok-4-1-fast-reasoning
# OpenAI: gpt-4o, gpt-4-turbo
# Groq: llama-3.1-70b-versatile
LLM_MODEL=grok-4-1-fast-reasoning

# =============================================================================
# BACKEND - Retrieval Settings
# =============================================================================

# Number of chunks to retrieve for context
TOP_K_CHUNKS=6

# Minimum similarity score (0.0-1.0) to include a chunk
MIN_SIMILARITY_THRESHOLD=0.3

# Maximum context tokens to send to LLM
MAX_CONTEXT_TOKENS=8000

# Maximum conversation history messages
MAX_HISTORY_MESSAGES=10

# =============================================================================
# BACKEND - API Settings
# =============================================================================

# Environment mode: "development" or "production"
APP_ENV=development

# CORS origins (JSON array for production)
# Development: defaults to ["http://localhost:3000"]
# Production: set to your deployed frontend URLs
# Example: CORS_ORIGINS='["https://epfiles.app"]'
CORS_ORIGINS=

# =============================================================================
# INTERFACE - Backend Connection (Required)
# =============================================================================

# URL to the RAG backend API
# Local: http://localhost:8000
# Production: your deployed backend URL
BACKEND_URL=http://localhost:8000

# =============================================================================
# INTERFACE - Clerk Authentication (Required)
# =============================================================================
# Get your keys from https://dashboard.clerk.com/

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
