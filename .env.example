# Required API Keys
OPENAI_API_KEY=sk-xxx              # For embeddings (text-embedding-3-large)
XAI_API_KEY=xai-xxx                # For LLM inference (Grok)

# PostgreSQL connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/epfiles

# ChromaDB Configuration
CHROMA_DB_PATH=./chroma_db
COLLECTION_NAME=epstein_files

# Embedding model for vector search
EMBEDDING_MODEL=text-embedding-3-large

# LLM Configuration (xAI/Grok)
# LLM_MODEL=grok-4-1-fast-reasoning
# LLM_MAX_TOKENS=1000
# LLM_TEMPERATURE=0.1
# XAI_BASE_URL=https://api.x.ai/v1

# Retrieval Settings
TOP_K_CHUNKS=6
MIN_SIMILARITY_THRESHOLD=0.3
MAX_CONTEXT_TOKENS=8000

# Conversation Settings
MAX_HISTORY_MESSAGES=10

# Environment mode: "development" or "production"
APP_ENV=development

# Frontend URL (for CORS in development)
BACKEND_URL=http://localhost:8000
