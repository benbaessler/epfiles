# =============================================================================
# Epfiles Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# See docs/CONFIGURATION.md for detailed documentation of all options.
# =============================================================================

# -----------------------------------------------------------------------------
# API Keys (Required)
# -----------------------------------------------------------------------------

# OpenAI API Key - Required for embedding generation (text-embedding-3-large)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxx

# xAI API Key - Optional, users can provide their own via UI
# Get your key at: https://console.x.ai/
XAI_API_KEY=xai-xxx

# -----------------------------------------------------------------------------
# Database (Required)
# -----------------------------------------------------------------------------

# PostgreSQL connection string
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://epfiles:epfiles@localhost:5432/epfiles

# Connection pool settings (optional)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10

# -----------------------------------------------------------------------------
# RAG Configuration (Optional - defaults shown)
# -----------------------------------------------------------------------------

# Path to ChromaDB storage
# CHROMA_DB_PATH=./chroma_db

# URL to download pre-built ChromaDB (auto-downloaded on first startup)
# CHROMADB_DOWNLOAD_URL=https://pub-bb289fb1eb1845dda7000f73a13d37cd.r2.dev/chroma_db.zip

# ChromaDB collection name
# COLLECTION_NAME=epstein_files

# OpenAI embedding model
# EMBEDDING_MODEL=text-embedding-3-large

# -----------------------------------------------------------------------------
# LLM Configuration (Optional - defaults shown)
# -----------------------------------------------------------------------------

# xAI model identifier
# LLM_MODEL=grok-4-1-fast-reasoning

# Maximum tokens in LLM response
# LLM_MAX_TOKENS=1000

# LLM temperature (0-1)
# LLM_TEMPERATURE=0.1

# xAI API base URL
# XAI_BASE_URL=https://api.x.ai/v1

# -----------------------------------------------------------------------------
# Retrieval Settings (Optional - defaults shown)
# -----------------------------------------------------------------------------

# Number of chunks to retrieve per query
# TOP_K_CHUNKS=6

# Minimum similarity score (0-1)
# MIN_SIMILARITY_THRESHOLD=0.3

# Maximum tokens in context window
# MAX_CONTEXT_TOKENS=8000

# Conversation history messages to include
# MAX_HISTORY_MESSAGES=10

# -----------------------------------------------------------------------------
# Rate Limiting (Optional - defaults shown)
# -----------------------------------------------------------------------------

# Free tier message limit
# FREE_MESSAGE_LIMIT=10

# Rate limit window in seconds (default: 24 hours)
# RATE_LIMIT_WINDOW_SECONDS=86400

# -----------------------------------------------------------------------------
# Application Settings (Optional)
# -----------------------------------------------------------------------------

# Environment mode: "development" or "production"
# APP_ENV=development

# CORS origins (JSON array) - Required in production
# Development default: ["http://localhost:3000"]
# CORS_ORIGINS='["https://your-domain.com"]'

# API documentation title
# API_TITLE=Epstein Files RAG API

# API version string
# API_VERSION=1.0.0

# -----------------------------------------------------------------------------
# Frontend Configuration
# -----------------------------------------------------------------------------

# Backend API URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Environment mode
NEXT_PUBLIC_APP_ENV=development

# Display value for free tier limit
NEXT_PUBLIC_FREE_MESSAGE_COUNT=10

# -----------------------------------------------------------------------------
# Analytics (Optional)
# -----------------------------------------------------------------------------

# PostHog analytics
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# -----------------------------------------------------------------------------
# Authentication (Optional - Clerk)
# -----------------------------------------------------------------------------

# Clerk publishable key (client-side)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx

# Clerk secret key (server-side)
# CLERK_SECRET_KEY=sk_live_xxx
