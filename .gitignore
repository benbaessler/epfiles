# =============================================================================
# EPFiles Root .gitignore
# =============================================================================

# Environment files
.env
.env.local
.env.*.local

# OS files
.DS_Store
Thumbs.db

# IDE
.cursor/
.vscode/
.idea/

# =============================================================================
# Python (Backend & Dataset)
# =============================================================================
venv/
.venv/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# =============================================================================
# Node.js (Interface)
# =============================================================================
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js
.next/
out/

# Testing
coverage/

# Build
build/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# =============================================================================
# Data (Dataset & Backend)
# =============================================================================
# Raw source files (too large for git)
packages/dataset/raw/
packages/dataset/repos/
packages/dataset/extracted/
packages/dataset/clean/
packages/dataset/thirdparty/
packages/dataset/chunks/
packages/dataset/finetune/
packages/dataset/training/

# ChromaDB vector store (regeneratable)
packages/backend/chroma_db/
chroma_db/
